# ─────────────────────────────────────────────────────────────────────────────
# Routine Rush Watch — project defaults
#
# Requires ESP-IDF v5.5+ (vendor CI baseline v5.5.5). The Waveshare board BSP
# `waveshare/esp32_c6_touch_amoled_2_06 ^2.0.0` declares `idf: ">=5.5.0"` and
# will NOT resolve on v5.4.x — the dependency solver fails outright.
#
# Several settings here encode hardware findings from Phase 0 board bring-up.
# Read the comments before changing any of them; the console block in
# particular has a silent failure mode.
# ─────────────────────────────────────────────────────────────────────────────

CONFIG_IDF_TARGET="esp32c6"

# ── Flash: 16MB, QIO @ 80MHz ────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ═════════════════════════════════════════════════════════════════════════════
# ⚠️  CONSOLE — USB-Serial-JTAG ONLY.  DO NOT ROUTE THE CONSOLE TO UART.
#
# Waveshare's own examples ship with:
#     CONFIG_ESP_CONSOLE_UART_CUSTOM=y
#     CONFIG_ESP_CONSOLE_UART_TX_GPIO=16
#     CONFIG_ESP_CONSOLE_UART_RX_GPIO=17
#
# but GPIO 16 = QMI8658 INT1 and GPIO 17 = QMI8658 INT2 (Waveshare's own pin
# audit). Those are exactly the interrupt lines raise-to-wake (§10, Phase 6)
# and the pedometer (Phase 9) need.
#
# The failure mode is silent: NOTHING ERRORS. The IMU still reads fine over
# I2C, so the board looks healthy — but the interrupt lines are owned by the
# console driver, so wake-on-motion has to fall back to polling the IMU from
# the main CPU. That destroys the battery budget the whole power design rests
# on, and presents later as "the wake gesture is just unreliable".
#
# The C6 has USB-Serial-JTAG in silicon; we flash and monitor over the same
# single USB-C cable either way, so this costs us nothing.
# ═════════════════════════════════════════════════════════════════════════════
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=n
CONFIG_ESP_CONSOLE_NONE=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ── Wi-Fi: OFF. Never initialised. (spec §2.2) ──────────────────────────────
# BLE is the sole uplink. There is NO Kconfig switch to remove Wi-Fi in IDF
# 5.5 (CONFIG_ESP_WIFI_ENABLED is not a user-settable symbol — esp_wifi is
# always in the component graph). Exclusion is achieved by LINKER GARBAGE
# COLLECTION instead: if nothing ever references esp_wifi_init(), the MAC/PHY
# stack is never pulled into the image.
#
# Verified on this scaffold: the ELF contains no esp_wifi_init / ieee80211_*
# symbols — only shared modem-clock HAL functions, which BLE needs too.
#
# THE RULE THIS DEPENDS ON: never add esp_wifi to a component's REQUIRES, and
# never call esp_wifi_*(). One stray reference silently drags the whole stack
# back in and costs RAM we do not have. CI asserts this on every build.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n

# ── Bluetooth: NimBLE only (peripheral role) ────────────────────────────────
# The watch is a GATT *server*/peripheral; the phone is the central (§6B.1).
# NimBLE is the smaller stack — relevant when RAM is the binding constraint.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# ═════════════════════════════════════════════════════════════════════════════
# ⚠️ BONDS MUST SURVIVE A REBOOT. THIS IS NOT OPTIONAL ON A BONDED PERIPHERAL.
#
# Without NVS_PERSIST, NimBLE keeps bonds in RAM ONLY. Everything looks correct
# for exactly as long as the watch stays powered: pairing succeeds, the link
# encrypts, a sync completes. Then it reboots and comes up with ZERO BONDS —
# while the phone still holds its LTK, because an iOS app cannot delete a BLE
# bond.
#
# From there the watch is permanently broken and cannot fix itself:
#   • every reconnect fails encryption (enc_change status 7)
#   • iOS terminates the link (reason 531)
#   • the drain never runs, so completed runs are never uploaded
#   • the app re-prompts to pair, and each fresh BLE identity the watch rotates
#     to leaves ANOTHER stale row in the parent's Bluetooth settings
#
# Every one of those was observed on hardware and misdiagnosed as a separate
# bug — a stale-bond handler, an encryption-failure counter, a BLE-identity
# rotation, an off-by-one in QUEUE_PULL paging. They were all one missing flag.
#
# THE LESSON: "bond store: 0/3 slot(s) used" after a reboot is not a symptom to
# handle, it is a configuration error. A bonded peripheral that cannot remember
# a bond has no working state to recover to, and no amount of runtime recovery
# logic substitutes for persisting the key.
# ═════════════════════════════════════════════════════════════════════════════
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# ═════════════════════════════════════════════════════════════════════════════
# LVGL — PARTIAL RENDER. A full framebuffer does not fit.
#
# Measured on hardware in Phase 0: only ~274 KiB of dynamic RAM is free at
# boot (248 KiB main heap + 11 KiB + 15 KiB RTC), before LVGL, NimBLE, or any
# app state. There is NO PSRAM on this board.
#
# A full-screen 410x502 16bpp framebuffer is ~400 KiB. That is not "wasteful",
# it is larger than all the RAM we have. Render in horizontal bands instead.
#
#   BSP_DISPLAY_LVGL_BUF_HEIGHT = 50 lines
#   → 410 px * 50 lines * 2 B = ~41 KiB per buffer  (≈ 1/10 screen)
#
# The BSP default is 100 lines (~82 KiB). Raise this only with a heap
# measurement in hand, and never to the point of a full frame.
# ═════════════════════════════════════════════════════════════════════════════
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=50

CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
# Greek (el) is a first-class locale — keep a Cyrillic/Greek-capable font set.
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# ── I2C / I2S: match the board BSP ──────────────────────────────────────────
CONFIG_BSP_I2C_NUM=0
CONFIG_BSP_I2S_NUM=1

# ── FreeRTOS / system ───────────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# ═════════════════════════════════════════════════════════════════════════════
# Power management (Phase 10) — automatic light sleep is now ON
#
# The precondition set here in Phase 8 ("do not enable automatic light-sleep
# until raise-to-wake is proven on the IMU interrupt lines") has been met: the
# interrupt path works, and rr_imu now registers INT1 as a light-sleep GPIO wake
# source, which is a separate requirement the precondition did not anticipate.
# Light sleep POWERS THE CPU DOWN, so an ordinary GPIO ISR does not run — see
# the wake-source registration in rr_imu.c and rr_reset_button.c.
# ═════════════════════════════════════════════════════════════════════════════
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Real measurement instead of a config echo. Without this, rr_pm can only report
# what light sleep was CONFIGURED to do, which is how "ls=0" came to be read as
# evidence when it was nothing of the kind. Costs two counters on the idle path.
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y

# ── THE BLE BLOCKER, AND WHY IT WAS NOT ACTUALLY A BLOCKER ──────────────────
#
# Without BT_LE_SLEEP_ENABLE, components/bt/controller/esp32c6/bt.c never
# registers its sleep/wakeup callbacks and never calls
# esp_sleep_enable_bt_wakeup(). Light sleep would then stop the controller's
# clock with nothing arranged to bring it back for the next advertising event,
# and BLE would quietly rot — missed adverts, dropped links.
#
# docs/POWER.md concluded this could not be fixed on this board, because BLE
# sleep "wants a 32.768 kHz low-power clock" and the C6's XTAL_32K pins
# (GPIO0/GPIO1) are QSPI_SCL and QSPI_SIO0 for the display. The premise is true;
# the conclusion was not. BT_LE_LP_CLK_SRC_MAIN_XTAL exists for precisely this
# board — IDF's own help text calls it "recommended if external 32.768k XTAL is
# not available". The trade it makes is real and worth stating: light sleep can
# no longer power down the main XTAL, so the sleeping floor is higher than it
# would be with a crystal. Higher floor beats no sleep at all.
#
# MAC_BB_PD is not optional here, it is a build requirement: esp32c6/bt.c has
# `#error "CONFIG_MAC_BB_PD required for BLE light sleep to run properly"` under
# SOC_PM_RETENTION_HAS_CLOCK_BUG, which the C6 sets. Costs ~2 KB of RAM.
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_LP_CLK_SRC_MAIN_XTAL=y
CONFIG_ESP_PHY_MAC_BB_PD=y

# ── Keep the console usable, at zero cost to battery ────────────────────────
#
# USB-Serial-JTAG CANNOT operate across light sleep — the CDC link drops and the
# log simply stops. The first light-sleep build went dark ~9 s after boot, the
# moment the screen slept, and a silent console is indistinguishable from a
# crash. This makes IDF hold a NO_LIGHT_SLEEP lock for exactly as long as a USB
# host is attached.
#
# It costs nothing that matters: VBUS present means the watch is on a charger,
# which is the one state where draw is irrelevant — and rr_powerlog refuses to
# measure on USB for that same reason. Off the cable, the lock is released and
# the watch sleeps normally.
#
# ⚠️ CONSEQUENCE FOR VERIFICATION: `ls`/`slp%` in the heartbeat will read 0 the
# whole time the watch is plugged in, and that is CORRECT rather than a
# regression. Because rr_pm's counters are cumulative, the way to prove sleep
# works is to unplug, wait, replug, and read the numbers that accrued while the
# cable was out. See docs/POWER.md.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# ── LVGL QR code widget (Phase 2 pairing screen) ────────────────────────────
# lv_qrcode renders into an LV_COLOR_FORMAT_I1 (1 bpp) canvas, so a 320x320
# symbol costs ~12.8 KiB — not the ~205 KiB a 16bpp canvas would need. That is
# what makes it affordable without PSRAM.
CONFIG_LV_USE_QRCODE=y

# ═════════════════════════════════════════════════════════════════════════════
# LVGL filesystem + image cache (Phase 4)
#
# The emoji manifest (generated in the app repo, not editable here) emits paths
# like "/lfs/emoji/1faa5.bin". LVGL addresses files as "<LETTER>:<path>", so we
# register the POSIX driver as letter 'L' (76) with an EMPTY working directory.
# An LVGL path is then literally "L:" + the manifest path, and littlefs is
# mounted at /lfs to match.
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=76
CONFIG_LV_FS_POSIX_PATH=""
CONFIG_LV_FS_POSIX_CACHE_SIZE=512

# Image handling — the heap-critical decision on a board with ~180 KiB free.
#
# LV_BIN_DECODER_RAM_LOAD=n (the default, made explicit): the bin decoder
# STREAMS an RGB565A8 image from flash as it draws, instead of loading the
# whole thing. A 96x96 RGB565A8 emoji is 27,660 bytes; loading one would spend
# ~15% of our working RAM on a single glyph, and the routine runtime shows a
# step's emoji for minutes at a time where the read cost is irrelevant.
CONFIG_LV_BIN_DECODER_RAM_LOAD=n

# Cache disabled deliberately. Caching only pays when decoding is expensive
# (PNG/JPEG); these are raw framebuffer-format blobs with no decode step, so a
# cache would trade real RAM for nothing. The single-step-focus design also
# shows exactly ONE emoji at a time, so there is no working set to retain.
# Revisit only if profiling shows the per-draw reads hurting the ring animation.
CONFIG_LV_CACHE_DEF_SIZE=0
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=4
